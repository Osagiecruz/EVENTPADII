    "react-intersection-observer": "^9.5.3",
    "react-leaflet": "^4.2.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.1",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.8",
    "redux-persist": "^6.0.0",
    "uuid": "^9.0.1"
