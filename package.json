{
  "name": "eventpadii",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:add": "npx cap add",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open",
    "cap:run": "npx cap run",
    "cap:build": "npm run build && npx cap sync",
    "android": "npm run cap:build && npx cap run android",
    "ios": "npm run cap:build && npx cap run ios",
    "android:dev": "npm run cap:build && npx cap run android --livereload --external",
    "ios:dev": "npm run cap:build && npx cap run ios --livereload --external"
  },
  "dependencies": {
